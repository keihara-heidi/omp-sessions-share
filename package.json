{
  "name": "omp-sessions-share",
  "version": "0.4.1",
  "description": "macOS OMP plugin: opt-in local session-share dashboard, Tailscale Serve, and native /collab host.",
  "license": "MIT",
  "type": "module",
  "os": ["darwin"],
  "keywords": [
    "omp-plugin",
    "omp",
    "oh-my-pi",
    "collab",
    "tailscale",
    "sessions",
    "share"
  ],
  "bin": {
    "omp-sessions-share": "./setup/cli.ts"
  },
  "files": [
    "LICENSE",
    "README.md",
    "daemon",
    "extension",
    "lib/auth.ts",
    "lib/contracts.ts",
    "out",
    "setup",
    "shared"
  ],
  "omp": {
    "extensions": ["./extension/index.ts"]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "setup": "bun setup/cli.ts",
    "export:web": "next build",
    "prepack": "bun run build"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "17.2.15"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@eslint/eslintrc": "^3.3.6",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "fuse.js": "^7.5.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "^15.5.2",
